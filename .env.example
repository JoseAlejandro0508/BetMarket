# =========================
# App domain (reverse proxy)
# =========================
APP_DOMAIN=apuestas.tudominio.com

# =========================
# JWT
# =========================
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_MUY_LARGO_Y_ALEATORIO
JWT_ISSUER=ApuestasDeportivas.Api
JWT_AUDIENCE=ApuestasDeportivas.Web
JWT_EXPIRY_MINUTES=240

# =========================
# Odds API
# =========================
ODDS_API_KEY=TU_ODDS_API_KEY
ODDS_SYNC_DEFAULT_INTERVAL_SECONDS=60

# =========================
# Admin seed (primer arranque)
# =========================
SEED_ADMIN_EMAIL=admin@tudominio.com
SEED_ADMIN_PASSWORD=Admin123!CAMBIAR

# =========================
# Traefik cert resolver
# =========================
TRAEFIK_CERTRESOLVER=letsencrypt
